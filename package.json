{
  "name": "undeclared-dependency-companion",
  "displayName": "Undeclared Dependency Companion",
  "description": "Flags packages imported in your code but not declared in package.json — a common slopsquatting / supply-chain risk. 100% local, no network.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "dependencies",    "supply-chain",    "slopsquatting",    "security",    "imports",    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-undeclared-dependency-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-undeclared-dependency-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
